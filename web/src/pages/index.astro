---
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

const title = 'O Que Fizeram';
---

<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p class="lede">
        Resumos semanais da atividade parlamentar portuguesa, comparada com o programa eleitoral
        de cada partido. Cada etiqueta abaixo já foi revista e aprovada por um humano — nada aqui
        é publicado diretamente por um modelo de IA. Ver a <a href="/methodology">metodologia</a>,
        o <a href="/glossario">glossário</a>, os <a href="/explicadores">explicadores</a>,
        a <a href="/privacidade">política de privacidade</a> ou como <a href="/correcoes">pedir uma correção</a>.
      </p>
      <form id="filters" class="filters" hidden>
        <fieldset>
          <legend>Partidos</legend>
          <div id="party-checkboxes" class="checkbox-grid"></div>
        </fieldset>
        <fieldset>
          <legend>Semana</legend>
          <label for="from-week">De</label>
          <input type="date" id="from-week" name="from-week" />
          <label for="to-week">Até</label>
          <input type="date" id="to-week" name="to-week" />
        </fieldset>
        <button id="clear-filters" type="button" class="button-secondary">Limpar filtros</button>
      </form>
      <p id="digest-status" role="status">A carregar...</p>
      <div id="digest"></div>
    </main>

    <script>
      import { supabase } from '../lib/supabase-client';
      import {
        filterDigestRows,
        groupDigestRowsByInitiative,
        groupInitiativeCardsByWeek,
        rowToDigestItem,
        type DigestItem,
        type DigestRow,
        type InitiativeDigestCard,
        type WeekSection,
      } from '../lib/digest';
      import { rowToVotacao, type VotacaoRow } from '../lib/votes';
      import { flattenPartyRosterSiglas, rowToPartyProgram, type PartyProgramRow } from '../lib/party-roster';
      import { formatDate } from '../lib/format';
      import { appendMaybeGlossaryLink, renderVoteResult } from '../lib/vote-render';

      const LABEL_NAMES: Record<string, string> = {
        aligned: 'Alinhado',
        partially_aligned: 'Parcialmente alinhado',
        contradicts: 'Contradiz',
        not_addressed: 'Não abordado no programa',
      };

      const digestEl = document.getElementById('digest') as HTMLElement;
      const statusEl = document.getElementById('digest-status') as HTMLElement;
      const filtersEl = document.getElementById('filters') as HTMLElement;
      const partyCheckboxesEl = document.getElementById('party-checkboxes') as HTMLElement;
      const fromWeekInput = document.getElementById('from-week') as HTMLInputElement;
      const toWeekInput = document.getElementById('to-week') as HTMLInputElement;
      const clearFiltersButton = document.getElementById('clear-filters') as HTMLButtonElement;

      // Populated once after the initial fetch; filtering/re-rendering
      // below never refetches — purely a client-side view over data
      // already fetched once.
      let allRows: DigestRow[] = [];
      let allSiglas: string[] = [];
      const votacoesCache = new Map<number, VotacaoRow[]>();

      function formatWeek(weekStart: string): string {
        const start = new Date(`${weekStart}T00:00:00Z`);
        const end = new Date(start);
        end.setUTCDate(end.getUTCDate() + 6);
        const fmt = (d: Date) => d.toLocaleDateString('pt-PT', { day: 'numeric', month: 'short' });
        return `${fmt(start)} – ${fmt(end)}`;
      }

      async function fetchVotacoesFor(iniciativaIds: number[]): Promise<void> {
        const missing = iniciativaIds.filter((id) => !votacoesCache.has(id));
        if (missing.length === 0) return;

        const { data, error } = await supabase.from('votacoes').select('*').in('iniciativa_id', missing);
        if (error) {
          throw new Error(error.message);
        }
        const byIniciativa = new Map<number, VotacaoRow[]>();
        for (const row of data ?? []) {
          const votacao = rowToVotacao(row);
          const iniciativaId = row.iniciativa_id as number;
          const list = byIniciativa.get(iniciativaId) ?? [];
          list.push(votacao);
          byIniciativa.set(iniciativaId, list);
        }
        for (const id of missing) {
          votacoesCache.set(id, byIniciativa.get(id) ?? []);
        }
      }

      async function loadPartyRoster(): Promise<void> {
        const { data, error } = await supabase
          .from('party_programs')
          .select('label, party_name, ar_siglas')
          .order('id', { ascending: true });
        if (error) {
          throw new Error(error.message);
        }
        const roster: PartyProgramRow[] = (data ?? []).map(rowToPartyProgram);
        allSiglas = flattenPartyRosterSiglas(roster);
      }

      function renderVerdictDetail(item: DigestItem): HTMLElement {
        const detail = document.createElement('div');
        detail.className = 'verdict-detail';

        if (item.quotedPassage) {
          const passageHeading = document.createElement('h5');
          passageHeading.textContent = `Passagem do programa (página ${item.citationPageNumber})`;
          detail.appendChild(passageHeading);

          const passage = document.createElement('blockquote');
          passage.textContent = item.quotedPassage;
          detail.appendChild(passage);

          const programLink = document.createElement('a');
          programLink.href = item.programSourceUrl;
          programLink.target = '_blank';
          programLink.rel = 'noopener noreferrer';
          programLink.textContent = `Ver programa de ${item.partyName}`;
          detail.appendChild(programLink);
        }

        if (item.rationale) {
          const rationaleHeading = document.createElement('h5');
          rationaleHeading.textContent = 'Porque este veredicto';
          detail.appendChild(rationaleHeading);

          const rationale = document.createElement('p');
          rationale.textContent = item.rationale;
          detail.appendChild(rationale);
        }

        const reportLink = document.createElement('a');
        reportLink.href = `/correcoes?verdict_id=${item.verdictId}&titulo=${encodeURIComponent(item.titulo)}`;
        reportLink.textContent = 'Reportar um problema com este veredicto';
        detail.appendChild(reportLink);

        return detail;
      }

      function renderAlignmentItem(item: DigestItem): HTMLElement {
        const li = document.createElement('li');
        li.className = 'alignment-item';

        const summary = document.createElement('p');
        const labelChip = document.createElement('span');
        labelChip.className = `label-chip label-chip--${item.label}`;
        labelChip.textContent = LABEL_NAMES[item.label] ?? item.label;
        summary.appendChild(labelChip);
        summary.appendChild(document.createTextNode(` ${item.partyName} · ${item.topic}`));
        li.appendChild(summary);

        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'button-link';
        toggle.textContent = 'Ver detalhe';
        toggle.setAttribute('aria-expanded', 'false');
        li.appendChild(toggle);

        // aria-expanded reflects this disclosure button's state
        // programmatically, not just via its visible text (WCAG 4.1.2).
        let detailEl: HTMLElement | null = null;
        toggle.addEventListener('click', () => {
          if (detailEl) {
            detailEl.hidden = !detailEl.hidden;
            toggle.textContent = detailEl.hidden ? 'Ver detalhe' : 'Esconder detalhe';
            toggle.setAttribute('aria-expanded', String(!detailEl.hidden));
            return;
          }
          detailEl = renderVerdictDetail(item);
          li.appendChild(detailEl);
          toggle.textContent = 'Esconder detalhe';
          toggle.setAttribute('aria-expanded', 'true');
        });

        return li;
      }

      function renderInitiativeCard(card: InitiativeDigestCard): HTMLElement {
        const article = document.createElement('article');
        article.className = 'initiative-card';

        const heading = document.createElement('h3');
        appendMaybeGlossaryLink(heading, card.tipoDesc);
        if (card.canonicalUrl) {
          heading.appendChild(document.createTextNode(': '));
          const link = document.createElement('a');
          link.href = card.canonicalUrl;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = card.titulo;
          heading.appendChild(link);
        } else {
          heading.appendChild(document.createTextNode(`: ${card.titulo}`));
        }
        article.appendChild(heading);

        const meta = document.createElement('p');
        meta.className = 'initiative-meta';
        meta.textContent = `n.º ${card.numero}` + (card.dataEntrada ? ` · ${formatDate(card.dataEntrada)}` : '');
        article.appendChild(meta);

        const voteHeading = document.createElement('h4');
        voteHeading.textContent = 'Como votou cada partido';
        article.appendChild(voteHeading);
        article.appendChild(renderVoteResult(votacoesCache.get(card.iniciativaId) ?? [], allSiglas));

        const alignmentHeading = document.createElement('h4');
        alignmentHeading.textContent = 'Alinhamento com os partidos';
        article.appendChild(alignmentHeading);

        const alignmentList = document.createElement('ul');
        alignmentList.className = 'alignment-list';
        for (const verdict of card.verdicts) {
          alignmentList.appendChild(renderAlignmentItem(verdict));
        }
        article.appendChild(alignmentList);

        return article;
      }

      function renderWeekSection(section: WeekSection): HTMLElement {
        const container = document.createElement('section');
        container.className = 'week-section';

        const heading = document.createElement('h2');
        heading.textContent = `Semana de ${formatWeek(section.weekStart)}`;
        container.appendChild(heading);

        for (const card of section.initiatives) {
          container.appendChild(renderInitiativeCard(card));
        }

        return container;
      }

      function buildPartyCheckboxes(rows: DigestRow[]) {
        // Only parties actually present in the fetched data get a
        // checkbox — never an empty option for a party with zero approved
        // verdicts yet.
        const parties = new Map<string, string>();
        for (const row of rows) {
          parties.set(row.partyLabel, row.partyName);
        }

        partyCheckboxesEl.replaceChildren();
        for (const [label, name] of parties) {
          const wrapper = document.createElement('label');
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.value = label;
          checkbox.checked = true;
          checkbox.addEventListener('change', render);
          wrapper.appendChild(checkbox);
          wrapper.appendChild(document.createTextNode(` ${name}`));
          partyCheckboxesEl.appendChild(wrapper);
        }
      }

      function selectedPartyLabels(): Set<string> {
        const checked = partyCheckboxesEl.querySelectorAll('input[type="checkbox"]:checked');
        return new Set([...checked].map((el) => (el as HTMLInputElement).value));
      }

      function render() {
        const filtered = filterDigestRows(allRows, {
          partyLabels: selectedPartyLabels(),
          fromWeek: fromWeekInput.value || undefined,
          toWeek: toWeekInput.value || undefined,
        });
        const sections = groupInitiativeCardsByWeek(groupDigestRowsByInitiative(filtered));

        digestEl.replaceChildren();
        if (sections.length === 0) {
          statusEl.textContent =
            allRows.length === 0
              ? 'Ainda não há veredictos aprovados publicados.'
              : 'Nenhum resultado para estes filtros.';
          return;
        }
        statusEl.textContent = '';
        for (const section of sections) {
          digestEl.appendChild(renderWeekSection(section));
        }
      }

      clearFiltersButton.addEventListener('click', () => {
        for (const checkbox of partyCheckboxesEl.querySelectorAll('input[type="checkbox"]')) {
          (checkbox as HTMLInputElement).checked = true;
        }
        fromWeekInput.value = '';
        toWeekInput.value = '';
        render();
      });
      fromWeekInput.addEventListener('change', render);
      toWeekInput.addEventListener('change', render);

      async function loadDigest() {
        try {
          await loadPartyRoster();

          const { data, error } = await supabase
            .from('public_digest')
            .select('*')
            .order('week_start', { ascending: false })
            .limit(200);

          if (error) {
            statusEl.textContent = `Erro ao carregar o resumo: ${error.message}`;
            return;
          }

          allRows = (data ?? []).map(rowToDigestItem);
          if (allRows.length > 0) {
            filtersEl.hidden = false;
            buildPartyCheckboxes(allRows);
            await fetchVotacoesFor([...new Set(allRows.map((row) => row.iniciativaId))]);
          }
          render();
        } catch (err) {
          statusEl.textContent = `Erro ao carregar o resumo: ${err instanceof Error ? err.message : String(err)}`;
        }
      }

      await loadDigest();
    </script>
  </body>
</html>
